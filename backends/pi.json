{
  "schema_version": 1,
  "name": "pi",
  "display_name": "Pi",
  "kind": "adapter-prompt-file",
  "auto_priority": 10,
  "discovery": {
    "binaries": {
      "pi": {},
      "node": {}
    },
    "adapter": {
      "env": "PI_AGENT_TASK",
      "candidates": [
        "{skill_dir}/../using-pi-agent/scripts/pi-agent-task.py",
        "~/.codex/skills/using-pi-agent/scripts/pi-agent-task.py"
      ]
    }
  },
  "adapter": {
    "path_tools": {"flag": "--tools", "value": "read,grep,find,ls"},
    "timeout_flag": "--wall-timeout-seconds",
    "env_hook": null,
    "result": {"strategy": "envelope", "envelope_type": "pi_task_result"},
    "prompt_limit": null
  },
  "identity": {
    "provider": {"flag": "--provider"},
    "model": {"flag": "--model"},
    "effort": {"flag": "--effort"}
  },
  "timeouts": {"review-paths": null, "default": null},
  "notes": "references/backend-pi.md"
}
