{
  "schema_version": 1,
  "name": "pi",
  "display_name": "Pi",
  "kind": "adapter-prompt-file",
  "auto_priority": 10,
  "discovery": {
    "binaries": {
      "pi": {
        "basename": "pi",
        "adapter_flag": "--pi-bin",
        "trace_sha256": true
      },
      "node": {
        "basename": "node",
        "adapter_flag": "--node-bin",
        "trace_sha256": true
      }
    },
    "adapter": {
      "env": "PI_AGENT_TASK",
      "candidates": [
        "{skill_dir}/scripts/adapters/pi-agent-task.py"
      ]
    }
  },
  "adapter": {
    "path_tools": {"flag": "--tools", "value": "read,grep,find,ls"},
    "timeout_flag": "--wall-timeout-seconds",
    "result": {"strategy": "envelope", "envelope_type": "pi_task_result"}
  },
  "identity": {
    "provider": {"flag": "--provider"},
    "model": {"flag": "--model"},
    "effort": {"flag": "--effort"}
  },
  "timeouts": {"review-paths": null, "default": null},
  "notes": "references/backends/pi/runtime.md"
}
